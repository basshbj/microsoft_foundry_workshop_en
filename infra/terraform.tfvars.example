gpt_model = {
  name     = "gpt-4o-mini"
  version  = "2024-07-18"
  sku_name = "GlobalStandard"
  capacity = 10
}

claude_model = {
  name     = "claude-sonnet-4-6"
  version  = "1"
  sku_name = "GlobalStandard"
  capacity = 25
}

gpt_tokens_per_minute    = 10000
